  "chunks": [
    {
      "id": "ocean-01",
      "source_id": "noaa-ocean",
      "topics": [
        "海洋",
        "大洋",
        "太平洋",
        "海盆"
      ],
      "text": "太平洋是地球面积最大、最深的海洋盆地，面积约1.62亿平方千米。太平洋周围的环太平洋火山地震带与板块俯冲活动有关。"
    },
    {
      "id": "moon-01",
      "source_id": "nasa-moon",
      "topics": [
        "月球",
        "天然卫星",
        "月亮"
      ],
      "text": "月球是地球唯一的天然卫星，绕地球运行，平均距离约38.5万千米。月球有岩石表面和撞击坑，外逸层非常稀薄，不能供人呼吸。"
    },
    {
      "id": "planets-01",
      "source_id": "nasa-planets",
      "topics": [
        "太阳系",
        "行星",
        "水星",
        "金星",
        "火星",
        "海王星",
        "天王星"
      ],
      "text": "太阳系有八颗行星：水星、金星、地球、火星、木星、土星、天王星、海王星。水星最靠近太阳。地球是距离太阳第三近的行星。"
    },
    {
      "id": "planets-02",
      "source_id": "nasa-planets",
      "topics": [
        "太阳系",
        "行星",
        "木星",
        "土星"
      ],
      "text": "木星是太阳系最大的行星，也是距离太阳第五近的行星。土星是第二大行星。木星和土星属于气态巨行星，天王星和海王星属于冰巨行星。"
    },
    {
      "id": "sun-01",
      "source_id": "nasa-sun",
      "topics": [
        "太阳",
        "恒星",
        "黄矮星"
      ],
      "text": "太阳是一颗约45亿岁的黄矮恒星，是太阳系中唯一的恒星，主要由氢和氦构成。太阳是炽热的等离子体，没有坚硬的固体表面。太阳不是行星。"
    },
    {
      "id": "light-01",
      "source_id": "doe-light",
      "topics": [
        "电灯",
        "灯泡",
        "白炽灯",
        "爱迪生",
        "斯旺"
      ],
      "text": "电灯的发展是许多发明者持续改进的结果，不能归功于单一发明者。爱迪生团队改进了白炽灯灯丝与真空技术，并推动商业化；斯旺等人也作出了贡献。"
    },
    {
      "id": "light-02",
      "source_id": "doe-light",
      "topics": [
        "电灯",
        "灯泡",
        "白炽灯",
        "爱迪生"
      ],
      "text": "爱迪生不仅改进灯泡，还发展了使电灯实用的配套系统，包括发电、配电和计量。电灯商业化涉及灯泡和电力系统的共同发展。"
    },
    {
      "id": "earth-orbit",
      "topics": [
        "地球",
        "自转",
        "公转",
        "日夜",
        "昼夜"
      ],
      "text": "地球围绕太阳公转，一周约365.25日；相对遥远恒星完成一次自转约23.9小时。公转周期与自转周期不同，昼夜交替与地球自转有关。",
      "source_id": "nasa-earth",
      "text_sha256": "28cf17c3ebeae0f620d4a7dc68bef33bd659594df3d909f93e80ec50fc5d14a1"
    },
    {
      "id": "earth-seasons",
      "topics": [
        "地球",
        "季节",
        "四季",
        "地轴"
      ],
      "text": "地球自转轴相对于轨道平面法线倾斜约23.4度，绕太阳公转时不同半球接受太阳辐射的角度和时长变化，产生季节变化。南北半球季节相反。",
      "source_id": "nasa-earth",
      "text_sha256": "db544ef66e5cae079ab9b49a9e746f77022d4ed8cbf77028d5c84b8f8b9d8573"
    },
    {
      "id": "relativity-special",
      "topics": [
        "相对论",
        "爱因斯坦",
        "光速不变",
        "狭义相对"
      ],
      "text": "狭义相对论由爱因斯坦在1905年提出，其原理包括匀速直线运动的相对性，以及所有观测者测得的真空光速相同。质能关系E=mc²与这一理论有关。",
      "source_id": "nasa-relativity",
      "text_sha256": "6bfa0ee0b10ef4c1a3f8d10ae4152822516208fc172c2fd0854b447c01104db4"
    },
    {
      "id": "relativity-general",
      "topics": [
        "相对论",
        "广义相对",
        "引力",
        "时空"
      ],
      "text": "广义相对论把相对论扩展到包含加速与引力的情形，用时空曲率描述引力，并预言黑洞、引力波及引力透镜等现象。",
      "source_id": "nasa-relativity",
      "text_sha256": "308b278efb3db5e8de4ba1225e598c2dec8fbfcf4d243af92e5ff525f07c29be"
    },
    {
      "id": "waves-mechanical",
      "topics": [
        "声波",
        "声音",
        "真空",
        "机械波",
        "介质"
      ],
      "text": "声波是机械波，需要物质介质传递扰动；真空中没有传递声波的介质，因此声音不能在真空中传播。机械波传递能量，并不等于把介质整体搬运到远处。",
      "source_id": "nasa-waves",
      "text_sha256": "5509f03ea97154ccb109febca5bbf779d72485977413de8f067951077ab4953d"
    },
    {
      "id": "waves-electromagnetic",
      "topics": [
        "电磁波",
        "真空",
        "电场",
        "磁场",
        "光波"
      ],
      "text": "变化的电场与磁场相互联系，形成电磁波。电磁波传播不要求物质介质，可以穿过真空；这一点与声波等机械波不同。",
      "source_id": "nasa-waves",
      "text_sha256": "11d89f09a240eddb7d94e85136cf7c388b5741fa3ffc37484cce64ca5858c516"
    },
    {
      "id": "apollo-crew",
      "topics": [
        "登月",
        "月球",
        "阿姆斯特朗",
        "阿波罗",
        "奥尔德林",
        "柯林斯"
      ],
      "text": "1969年阿波罗11号任务中，尼尔·阿姆斯特朗成为首位踏上月球的人，巴兹·奥尔德林是第二位。迈克尔·柯林斯担任指令舱驾驶员，在月球轨道执行任务，没有踏上月面。",
      "source_id": "nasa-apollo",
      "text_sha256": "4ee9bb2ec28df1c53166b7fa368e0870aa3697872fb615627c485ebc9b4acb33"
    },
    {
      "id": "apollo-date",
      "topics": [
        "阿波罗",
        "登月",
        "月球"
      ],
      "text": "阿波罗11号于1969年7月16日发射，7月20日登月。它是人类首次载人登月任务。",
      "source_id": "nasa-apollo",
      "text_sha256": "797e61981697117d428e527beb5fb22a15efbd64afe435addc823dd6db567100"
    },
    {
      "id": "bell-history",
      "topics": [
        "电话",
        "贝尔",
        "爱迪生",
        "送话器"
      ],
      "text": "贝尔在1876年11月26日用箱式电话进行了波士顿至塞勒姆的演示。后续商用电话采用的炭精变阻送话器与爱迪生申请专利的原理有关，因此电话发明与改进应区分具体贡献。",
      "source_id": "smithsonian-bell",
      "text_sha256": "fea8e4420545f7ec79080bccb1b8a7a67e67482968df459efe6c16c661126f74"
    },
    {
      "id": "bell-mechanism",
      "topics": [
        "电话",
        "送话器",
        "听筒",
        "振膜"
      ],
      "text": "贝尔电话中，声波使振膜运动，在电磁结构中产生变化电流；电流经导线到达接收端，引起另一振膜振动，产生可听见的空气振动。",
      "source_id": "smithsonian-bell",
      "text_sha256": "721d238e06a77d47467b0e306ac2c80488fe8ef850f958570d2db783aafb22bb"
    },
    {
      "id": "flight-history",
      "topics": [
        "飞机",
        "莱特",
        "动力飞行"
      ],
      "text": "莱特兄弟研制了1903年莱特飞行器。1903年12月17日，奥维尔在北卡罗来纳州基蒂霍克完成首次成功的载人动力飞机飞行。",
      "source_id": "smithsonian-flight",
      "text_sha256": "b781ee07165f251dee6a31eb598d8359ac5edd91fe73cb1f374ea45faab028a0"
    },
    {
      "id": "pyramids-history",
      "topics": [
        "金字塔",
        "埃及",
        "吉萨",
        "胡夫"
      ],
      "text": "埃及金字塔起源于古埃及王室陵墓的发展。吉萨大金字塔与古埃及国王胡夫有关，另两座主要金字塔与哈夫拉、孟卡拉有关。",
      "source_id": "smithsonian-pyramids",
      "text_sha256": "2f30804cbfcc95c9a9bef0b45aba4681d2a7d5dbf55fdf3b0c13f2ab97666a94"
    },
    {
      "id": "pyramids-form",
      "topics": [
        "金字塔",
        "阶梯",
        "左塞尔",
        "伊姆霍特普"
      ],
      "text": "左塞尔的建筑师伊姆霍特普通过逐层叠放更小的墓体建造了阶梯金字塔。后来金字塔形制继续演变，出现外表平滑的真正金字塔。",
      "source_id": "smithsonian-pyramids",
      "text_sha256": "ae943bda585b9f363d404b7ff67461a68421bd1f0ca7dc883bc6d23c1a35131a"
    },
    {
      "id": "steam-history",
      "topics": [
        "蒸汽机",
        "瓦特",
        "纽科门",
        "Newcomen",
        "Watt"
      ],
      "text": "纽科门与合作者约在1712年制造了成功的大气式蒸汽机，早于瓦特的机型。瓦特在蒸汽机发展中作出重要改进，不能将蒸汽机最初发明简单归为瓦特。",
      "source_id": "smithsonian-steam",
      "text_sha256": "c41e9dffdce49902316c28f55eca25a5b0540da9b8d4358bb827b91edd4308ec"
    },
    {
      "id": "steam-use",
      "topics": [
        "蒸汽机",
        "瓦特",
        "运河",
        "抽水"
      ],
      "text": "博尔顿与瓦特约1776至1778年为伯明翰运河公司设计建造抽水蒸汽机，把水从低处提升到高处，以支持船闸运行。",
      "source_id": "smithsonian-steam",
      "text_sha256": "61f36b01079d18eb550fd7abeb4c3a475950751a17d8f91402d67dcca609ced1"
    },
    {
      "id": "trench-depth",
      "topics": [
        "海沟",
        "马里亚纳",
        "挑战者",
        "Challenger"
      ],
      "text": "挑战者深渊位于马里亚纳海沟，是该海沟及世界海洋最深处，深度约11000米。它位于西太平洋菲律宾以东的马里亚纳群岛附近海域。",
      "source_id": "noaa-trench",
      "text_sha256": "ce304f3a201247f6a7b6f16acf6c0ab5b50a31da784be5c28ee6a9a77cfcdc39"
    },
    {
      "id": "water-molecule",
      "topics": [
        "水",
        "化学式",
        "H2O"
      ],
      "text": "水的分子式为H2O，每个水分子由两个氢原子和一个氧原子组成，原子间由共价键连接。",
      "source_id": "pubchem-water",
      "text_sha256": "6250b8f197377870518635615a0a12f4c1fb057471c201b44434bd0d416da257"
    },
    {
      "id": "light-constant",
      "topics": [
        "光速",
        "真空",
        "光的速度"
      ],
      "text": "真空中的光速是299792458米每秒，这是国际单位制中的精确定义值，而不是一个具有实验误差的近似测量值。粗略计算可以取3×10^8米每秒。",
      "source_id": "nist-light",
      "text_sha256": "2f553f74c269446c9bcea97626683477475c777d0071bd0c06b58d8ecfd04c41"
    },
    {
      "id": "nobel-einstein-1921",
      "topics": [
        "爱因斯坦",
        "Einstein",
        "光电效应",
        "1921年诺贝尔物理学奖"
      ],
      "scope": {
        "kind": "award_record",
        "award_category": "physics",
        "award_year": 1921,
        "subject_aliases": [
          "爱因斯坦",
          "Einstein"
        ]
      },
      "text": "爱因斯坦（Albert Einstein）获得1921年度诺贝尔物理学奖，该年度奖于1922年颁发。官方物理学奖历史说明，获奖与他对光电效应的解释有关，颁奖理由也涉及他对理论物理学的贡献。奖项年度与实际颁发年份需区别。",
      "source_id": "nobel-physics-history",
      "text_sha256": "0f0f82b3f493aefcf9e606a15cd0f1bd28c01f10aaad5f35fef921e373aa393c"
    },
    {
      "id": "nobel-einstein-relativity-history",
      "topics": [
        "爱因斯坦",
        "Einstein",
        "相对论",
        "时空"
      ],
      "scope": {
        "kind": "scientific_history",
        "subject_aliases": [
          "爱因斯坦",
          "Einstein"
        ]
      },
      "text": "官方物理学奖历史介绍，爱因斯坦在1905年发展狭义相对论，随后在下一个十年继续发展广义相对论，将引力与时空结构联系起来。同一历史资料另将他的1921年度物理学奖与光电效应工作联系，而非把相对论提出年份当作获奖年份。",
      "source_id": "nobel-physics-history",
      "text_sha256": "285afb93b7fcc0164a7856f4ea537b06dc4123fc5a225e79f75821e72b4f7c28"
    },
    {
      "id": "nobel-physics-repeat-through-2025",
      "topics": [
        "诺贝尔物理学奖",
        "巴丁",
        "巴登",
        "Bardeen",
        "重复获奖"
      ],
      "scope": {
        "kind": "award_statistics",
        "award_category": "physics",
        "through_year": 2025
      },
      "text": "在官方诺贝尔物理学奖名录所列1901至2025年的统计范围内，约翰·巴丁（John Bardeen）是唯一两次获得物理学奖的人，分别为1956年与1972年；该范围内的其他物理学奖得主各获该奖一次。此统计只涉及物理学奖，不是所有奖项类别的重复获奖统计，也不覆盖2026年。",
      "source_id": "nobel-physics-repeat-snapshot",
      "text_sha256": "88f54e950eddda2643cd05e0e2f65f195e66f8e480bb753d6ac75fd1999a61ae"
    },
    {
      "id": "nobel-physics-2022",
      "topics": [
        "诺贝尔物理学奖",
        "阿斯佩",
        "克劳泽",
        "蔡林格",
        "Aspect",
        "Clauser",
        "Zeilinger",
        "量子纠缠"
      ],
      "scope": {
        "kind": "award_record",
        "award_category": "physics",
        "award_year": 2022,
        "subject_aliases": [
          "阿斯佩",
          "克劳泽",
          "蔡林格",
          "Aspect",
          "Clauser",
          "Zeilinger"
        ]
      },
      "text": "2022年度诺贝尔物理学奖授予阿兰·阿斯佩（Alain Aspect）、约翰·克劳泽（John F. Clauser）和安东·蔡林格（Anton Zeilinger）。获奖工作涉及纠缠光子实验、验证贝尔不等式的违背，以及开创量子信息科学。这里的贝尔不等式属于物理学概念，不是电话发明史。",
      "source_id": "nobel-physics-2022-release",
      "text_sha256": "0b05d114163fbe48f7939bf155598c2b4796502881ace0eed5dde5900c028f62"
    },
    {
      "id": "nobel-physics-2023",
      "topics": [
        "诺贝尔物理学奖",
        "阿戈斯蒂尼",
        "克劳斯",
        "吕利耶",
        "Agostini",
        "Krausz",
        "Huillier",
        "阿秒"
      ],
      "scope": {
        "kind": "award_record",
        "award_category": "physics",
        "award_year": 2023,
        "subject_aliases": [
          "阿戈斯蒂尼",
          "克劳斯",
          "吕利耶",
          "Agostini",
          "Krausz",
          "Huillier"
        ]
      },
      "text": "2023年度诺贝尔物理学奖授予皮埃尔·阿戈斯蒂尼（Pierre Agostini）、费伦茨·克劳斯（Ferenc Krausz）和安妮·吕利耶（Anne L’Huillier）。获奖工作是产生阿秒光脉冲的实验方法，用于研究物质中的电子动力学，能够探测电子运动或能量变化等极快过程。",
      "source_id": "nobel-physics-2023-release",
      "text_sha256": "9a77eec4aa93fb28b88effc8a588a5b3c08ad93ae72cbabb24cd08ed803f878d"
    },
    {
      "id": "nobel-literature-2023",
      "topics": [
        "诺贝尔文学奖",
        "约恩·福瑟",
        "福瑟",
        "Jon Fosse"
      ],
      "scope": {
        "kind": "award_record",
        "award_category": "literature",
        "award_year": 2023,
        "subject_aliases": [
          "福瑟",
          "Jon Fosse"
        ]
      },
      "text": "瑞典文学院2023年10月5日公告将2023年度诺贝尔文学奖授予挪威作家约恩·福瑟（Jon Fosse），表彰其富有创新性的戏剧与散文，赋予难以言说的事物以声音。此公告支持该年度文学奖的获奖者和理由，不是其他年份或其他奖项类别的名单。",
      "source_id": "nobel-literature-2023-release",
      "text_sha256": "42e1dc6c934598dd8864667e49b37e95052b756161e9e0361748eeeaaacd3a25"
    }
  ],
